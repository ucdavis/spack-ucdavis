module-whatis {The Gdk Pixbuf is a toolkit for image loading and pixel buffer manipulation. It is used by GTK+ 2 and GTK+ 3 to load and manipulate images. In the past it was distributed as part of GTK+ 2 but it was split off into a separate package in preparation for the change to GTK+ 3.}

proc ModulesHelp { } {
    puts stderr {Name   : gdk-pixbuf}
    puts stderr {Version: 2.42.12}
    puts stderr {Target : zen2}
    puts stderr {}
    puts stderr {The Gdk Pixbuf is a toolkit for image loading and pixel buffer}
    puts stderr {manipulation. It is used by GTK+ 2 and GTK+ 3 to load and manipulate}
    puts stderr {images. In the past it was distributed as part of GTK+ 2 but it was}
    puts stderr {split off into a separate package in preparation for the change to GTK+}
    puts stderr {3.}
}

