module-whatis {libXtst provides the Xlib-based client API for the XTEST & RECORD extensions.}

proc ModulesHelp { } {
    puts stderr {Name   : libxtst}
    puts stderr {Version: 1.2.4}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {libXtst provides the Xlib-based client API for the XTEST & RECORD}
    puts stderr {extensions. The XTEST extension is a minimal set of client and server}
    puts stderr {extensions required to completely test the X11 server with no user}
    puts stderr {intervention. This extension is not intended to support general}
    puts stderr {journaling and playback of user actions. The RECORD extension supports}
    puts stderr {the recording and reporting of all core X protocol and arbitrary X}
    puts stderr {extension protocol.}
}

conflict libxtst

