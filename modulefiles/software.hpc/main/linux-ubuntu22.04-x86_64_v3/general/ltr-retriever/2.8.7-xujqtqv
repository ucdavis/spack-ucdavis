    puts stderr {Name   : ltr-retriever}
    puts stderr {Version: 2.8.7}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {LTR_retriever is a highly accurate and sensitive program for}
    puts stderr {identification of LTR retrotransposons.}
}

