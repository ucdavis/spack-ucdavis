module-whatis {MCE - Many-Core Engine for Perl providing parallel processing capabilities.}

proc ModulesHelp { } {
    puts stderr {Name   : perl-mce}
    puts stderr {Version: 1.889}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {MCE - Many-Core Engine for Perl providing parallel processing}
    puts stderr {capabilities. MCE spawns a pool of workers and therefore does not fork a}
    puts stderr {new process per each element of data. Instead, MCE follows a bank}
    puts stderr {queuing model. Imagine the line being the data and bank-tellers the}
    puts stderr {parallel workers. MCE enhances that model by adding the ability to chunk}
    puts stderr {the next n elements from the input stream to the next available worker.}
}

if {![info exists ::env(LMOD_VERSION_MAJOR)]} {
