prepend-path PERL5LIB {/cvmfs/hpc.ucdavis.edu/sw/spack/environments/main/view/generic/vcftools-0.1.16/lib}
setenv VCFTOOLS_ROOT {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/vcftools-0.1.16-qenqygoozs3yrmy74fdkrnewq7hvhzpb}
