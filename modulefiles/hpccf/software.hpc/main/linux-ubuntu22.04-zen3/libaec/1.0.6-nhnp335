module-whatis {Libaec provides fast lossless compression of 1 up to 32 bit wide signed or unsigned integers (samples). It implements Golomb-Rice compression method under the BSD license and includes a free drop-in replacement for the SZIP library. }

proc ModulesHelp { } {
    puts stderr {Name   : libaec}
    puts stderr {Version: 1.0.6}
    puts stderr {Target : zen3}
    puts stderr {}
    puts stderr {Libaec provides fast lossless compression of 1 up to 32 bit wide signed}
    puts stderr {or unsigned integers (samples). It implements Golomb-Rice compression}
    puts stderr {method under the BSD license and includes a free drop-in replacement for}
    puts stderr {the SZIP library.}
}

