    puts stderr {Name   : pixman}
    puts stderr {Version: 0.44.0}
    puts stderr {Target : zen3}
    puts stderr {}
    puts stderr {The Pixman package contains a library that provides low-level pixel}
    puts stderr {manipulation features such as image compositing and trapezoid}
    puts stderr {rasterization.}
}

