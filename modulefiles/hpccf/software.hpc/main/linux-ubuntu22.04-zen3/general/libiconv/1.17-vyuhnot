    puts stderr {Name   : libiconv}
    puts stderr {Version: 1.17}
    puts stderr {Target : zen3}
    puts stderr {}
    puts stderr {GNU libiconv provides an implementation of the iconv() function and the}
    puts stderr {iconv program for character set conversion.}
}

