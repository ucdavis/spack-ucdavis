module-whatis {AMD Optimized BLIS.}

proc ModulesHelp { } {
    puts stderr {Name   : amdblis}
    puts stderr {Version: 5.0}
    puts stderr {Target : zen2}
    puts stderr {}
    puts stderr {AMD Optimized BLIS. BLIS is a portable software framework for}
    puts stderr {instantiating high-performance BLAS-like dense linear algebra libraries.}
    puts stderr {The framework was designed to isolate essential kernels of computation}
    puts stderr {that, when optimized, immediately enable optimized implementations of}
    puts stderr {most of its commonly used and computationally intensive operations.}
    puts stderr {LICENSING INFORMATION: By downloading, installing and using this}
    puts stderr {software, you agree to the terms and conditions of the AMD AOCL-BLIS}
    puts stderr {license agreement. You may obtain a copy of this license agreement from}
    puts stderr {https://www.amd.com/en/developer/aocl/dense/eula/blas-4-2-eula.html}
    puts stderr {https://www.amd.com/en/developer/aocl/dense/eula/blas-eula.html}
}

if {![info exists ::env(LMOD_VERSION_MAJOR)]} {
    module load python/3.11.9%gcc@11.4.0-fo4apfe
} else {
    depends-on python/3.11.9%gcc@11.4.0-fo4apfe
}
