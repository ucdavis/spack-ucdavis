module-whatis {Zstandard, or zstd as short version, is a fast lossless compression algorithm, targeting real-time compression scenarios at zlib-level and better compression ratios.}

proc ModulesHelp { } {
    puts stderr {Name   : zstd}
    puts stderr {Version: 1.5.6}
    puts stderr {Target : zen2}
    puts stderr {}
    puts stderr {Zstandard, or zstd as short version, is a fast lossless compression}
    puts stderr {algorithm, targeting real-time compression scenarios at zlib-level and}
    puts stderr {better compression ratios.}
}

