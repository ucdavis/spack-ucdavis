module-whatis {libFLAME (AMD Optimized version) is a portable library for dense matrix computations, providing much of the functionality present in Linear Algebra Package (LAPACK). It includes a compatibility layer, FLAPACK, which includes complete LAPACK implementation.}

proc ModulesHelp { } {
    puts stderr {Name   : amdlibflame}
    puts stderr {Version: 5.0}
    puts stderr {Target : zen2}
    puts stderr {}
    puts stderr {libFLAME (AMD Optimized version) is a portable library for dense matrix}
    puts stderr {computations, providing much of the functionality present in Linear}
    puts stderr {Algebra Package (LAPACK). It includes a compatibility layer, FLAPACK,}
    puts stderr {which includes complete LAPACK implementation. The library provides}
    puts stderr {scientific and numerical computing communities with a modern, high-}
    puts stderr {performance dense linear algebra library that is extensible, easy to}
    puts stderr {use, and available under an open source license. libFLAME is a C-only}
    puts stderr {implementation and does not depend on any external FORTRAN libraries}
    puts stderr {including LAPACK. There is an optional backward compatibility layer,}
    puts stderr {lapack2flame that maps LAPACK routine invocations to their corresponding}
    puts stderr {native C implementations in libFLAME. This allows legacy applications to}
    puts stderr {start taking advantage of libFLAME with virtually no changes to their}
    puts stderr {source code. In combination with BLIS library which includes}
    puts stderr {optimizations for the AMD EPYC processor family, libFLAME enables}
    puts stderr {running high performing LAPACK functionalities on AMD platform.}
    puts stderr {LICENSING INFORMATION: By downloading, installing and using this}
    puts stderr {software, you agree to the terms and conditions of the AMD AOCL-libFLAME}
    puts stderr {license agreement. You may obtain a copy of this license agreement from}
    puts stderr {https://www.amd.com/en/developer/aocl/dense/eula-}
    puts stderr {libflame/libflame-4-2-eula.html}
    puts stderr {https://www.amd.com/en/developer/aocl/dense/eula-libflame/libflame-}
    puts stderr {eula.html}
}

