module-whatis {C++ software library providing well-documented tools to build finite element codes for a broad variety of PDEs.}

proc ModulesHelp { } {
    puts stderr {Name   : dealii}
    puts stderr {Version: 9.5.1}
    puts stderr {Target : zen2}
    puts stderr {}
    puts stderr {C++ software library providing well-documented tools to build finite}
    puts stderr {element codes for a broad variety of PDEs.}
}

