    puts stderr {Name   : aspect}
    puts stderr {Version: 2.5.0}
    puts stderr {Target : zen2}
    puts stderr {}
    puts stderr {Parallel and extensible Finite Element code to simulate convection in}
    puts stderr {the Earth's mantle and elsewhere.}
}

