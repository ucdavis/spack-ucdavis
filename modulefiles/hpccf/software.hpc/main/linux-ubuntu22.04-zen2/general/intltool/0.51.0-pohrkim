module-whatis {intltool is a set of tools to centralize translation of many different file formats using GNU gettext-compatible PO files.}

proc ModulesHelp { } {
    puts stderr {Name   : intltool}
    puts stderr {Version: 0.51.0}
    puts stderr {Target : zen2}
    puts stderr {}
    puts stderr {intltool is a set of tools to centralize translation of many different}
    puts stderr {file formats using GNU gettext-compatible PO files.}
}

if {![info exists ::env(LMOD_VERSION_MAJOR)]} {
    module load perl/5.40.0-cr2hpfl
    module load perl-xml-parser/2.47-xhhbtfe
} else {
    depends-on perl/5.40.0-cr2hpfl
    depends-on perl-xml-parser/2.47-xhhbtfe
}
conflict intltool

