    puts stderr {and conditions of the AMD AOCL-FFTW license agreement. You may obtain a}
    puts stderr {copy of this license agreement from}
    puts stderr {https://www.amd.com/en/developer/aocl/fftw/eula/fftw-}
    puts stderr {libraries-4-2-eula.html}
    puts stderr {https://www.amd.com/en/developer/aocl/fftw/eula/fftw-libraries-eula.html}
}

