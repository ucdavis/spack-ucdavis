    puts stderr {plaintext documentation into useful formats, such as HTML, LaTeX, man-}
    puts stderr {pages, open-document or XML. It includes reStructuredText, the easy to}
    puts stderr {read, easy to use, what-you-see-is-what-you-get plaintext markup}
    puts stderr {language.}
}

