    puts stderr {Name   : xz}
    puts stderr {Version: 5.4.6}
    puts stderr {Target : zen2}
    puts stderr {}
    puts stderr {XZ Utils is free general-purpose data compression software with high}
    puts stderr {compression ratio. XZ Utils were written for POSIX-like systems, but}
    puts stderr {also work on some not-so-POSIX systems. XZ Utils are the successor to}
    puts stderr {LZMA Utils.}
}

