module-whatis {OpenGL Extension to the X Window System.}

proc ModulesHelp { } {
    puts stderr {Name   : glproto}
    puts stderr {Version: 1.4.17}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {OpenGL Extension to the X Window System. This extension defines a}
    puts stderr {protocol for the client to send 3D rendering commands to the X server.}
}

