module-whatis {OrthoFinder is a fast, accurate and comprehensive analysis tool for comparative genomics.}

proc ModulesHelp { } {
    puts stderr {Name   : orthofinder}
    puts stderr {Version: 2.5.5}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {OrthoFinder is a fast, accurate and comprehensive analysis tool for}
    puts stderr {comparative genomics. It finds orthologues and orthogroups infers rooted}
    puts stderr {gene trees for all orthogroups and infers a rooted species tree for the}
    puts stderr {species being analysed. OrthoFinder also provides comprehensive}
    puts stderr {statistics for comparative genomic analyses. OrthoFinder is simple to}
    puts stderr {use and all you need to run it is a set of protein sequence files (one}
    puts stderr {per species) in FASTA format.}
}

