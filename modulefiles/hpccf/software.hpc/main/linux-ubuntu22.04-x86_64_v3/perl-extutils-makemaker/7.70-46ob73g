    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {ExtUtils::MakeMaker - Create a module Makefile. This utility is designed}
    puts stderr {to write a Makefile for an extension module from a Makefile.PL. It is}
    puts stderr {based on the Makefile.SH model provided by Andy Dougherty and the}
    puts stderr {perl5-porters.}
}

