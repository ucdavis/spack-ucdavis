    puts stderr {Name   : py-multiqc}
    puts stderr {Version: 1.23}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {MultiQC is a tool to aggregate bioinformatics results across many}
    puts stderr {samples into a single report. It is written in Python and contains}
    puts stderr {modules for a large number of common bioinformatics tools.}
}

