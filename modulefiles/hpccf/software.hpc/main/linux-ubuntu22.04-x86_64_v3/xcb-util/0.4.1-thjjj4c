module-whatis {The XCB util modules provides a number of libraries which sit on top of libxcb, the core X protocol library, and some of the extension libraries. These experimental libraries provide convenience functions and interfaces which make the raw X protocol more usable. Some of the libraries also provide client-side code which is not strictly part of the X protocol but which have traditionally been provided by Xlib.}

proc ModulesHelp { } {
    puts stderr {Name   : xcb-util}
    puts stderr {Version: 0.4.1}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The XCB util modules provides a number of libraries which sit on top of}
    puts stderr {libxcb, the core X protocol library, and some of the extension}
    puts stderr {libraries. These experimental libraries provide convenience functions}
    puts stderr {and interfaces which make the raw X protocol more usable. Some of the}
    puts stderr {libraries also provide client-side code which is not strictly part of}
    puts stderr {the X protocol but which have traditionally been provided by Xlib.}
}

