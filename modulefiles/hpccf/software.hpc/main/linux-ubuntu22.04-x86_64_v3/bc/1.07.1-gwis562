    puts stderr {Name   : bc}
    puts stderr {Version: 1.07.1}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {bc is an arbitrary precision numeric processing language. Syntax is}
    puts stderr {similar to C, but differs in many substantial areas. It supports}
    puts stderr {interactive execution of statements.}
}

