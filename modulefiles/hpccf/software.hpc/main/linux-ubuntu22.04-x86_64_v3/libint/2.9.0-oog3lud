    puts stderr {Name   : libint}
    puts stderr {Version: 2.9.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Libint is a high-performance library for computing Gaussian integrals in}
    puts stderr {quantum mechanics.}
}

