module-whatis {The wavefront alignment (WFA) algorithm is an exact gap-affine algorithm that takes advantage of homologous regions between the sequences to accelerate the alignment process.}

proc ModulesHelp { } {
    puts stderr {Name   : wfa2-lib}
    puts stderr {Version: 2.3.5}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The wavefront alignment (WFA) algorithm is an exact gap-affine algorithm}
    puts stderr {that takes advantage of homologous regions between the sequences to}
    puts stderr {accelerate the alignment process.}
}

