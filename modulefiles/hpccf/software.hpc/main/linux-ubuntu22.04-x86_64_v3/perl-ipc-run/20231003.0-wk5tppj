    puts stderr {Name   : perl-ipc-run}
    puts stderr {Version: 20231003.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {IPC::Run allows you to run and interact with child processes using}
    puts stderr {files, pipes, and pseudo-ttys. Both system()-style and scripted usages}
    puts stderr {are supported and may be mixed. Likewise, functional and OO API styles}
    puts stderr {are both supported and may be mixed.}
}

