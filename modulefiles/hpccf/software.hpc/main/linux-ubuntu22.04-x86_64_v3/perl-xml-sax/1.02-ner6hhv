module-whatis {XML::SAX is a SAX parser access API for Perl. It includes classes and APIs required for implementing SAX drivers, along with a factory class for returning any SAX parser installed on the user's system.}

proc ModulesHelp { } {
    puts stderr {Name   : perl-xml-sax}
    puts stderr {Version: 1.02}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {XML::SAX is a SAX parser access API for Perl. It includes classes and}
    puts stderr {APIs required for implementing SAX drivers, along with a factory class}
    puts stderr {for returning any SAX parser installed on the user's system.}
}

