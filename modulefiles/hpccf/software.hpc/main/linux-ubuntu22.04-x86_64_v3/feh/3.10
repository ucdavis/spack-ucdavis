   set deprecate_on "$env(deprecate_on)"
   unsetenv deprecate_on
   set deprecate_on_s [clock scan "$deprecate_on" -format "%Y-%m-%d"]
   set now_s [clock seconds]

   if { $now_s > $deprecate_on_s } {
