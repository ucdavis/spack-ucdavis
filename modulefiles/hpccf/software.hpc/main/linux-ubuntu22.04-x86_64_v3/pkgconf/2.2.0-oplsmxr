    puts stderr {Name   : pkgconf}
    puts stderr {Version: 2.2.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {pkgconf is a program which helps to configure compiler and linker flags}
    puts stderr {for development frameworks. It is similar to pkg-config from}
    puts stderr {freedesktop.org, providing additional functionality while also}
    puts stderr {maintaining compatibility.}
}

