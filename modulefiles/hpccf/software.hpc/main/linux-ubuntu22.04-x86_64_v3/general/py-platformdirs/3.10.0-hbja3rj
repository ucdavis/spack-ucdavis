    puts stderr {Name   : py-platformdirs}
    puts stderr {Version: 3.10.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {A small Python module for determining appropriate platform-specific}
    puts stderr {dirs, e.g. a "user data dir"}
}

