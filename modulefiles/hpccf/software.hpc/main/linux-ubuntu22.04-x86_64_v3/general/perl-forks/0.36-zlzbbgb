    puts stderr {Name   : perl-forks}
    puts stderr {Version: 0.36}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The "forks" pragma allows a developer to use threads without having to}
    puts stderr {have a threaded perl, or to even run 5.8.0 or higher.}
}

