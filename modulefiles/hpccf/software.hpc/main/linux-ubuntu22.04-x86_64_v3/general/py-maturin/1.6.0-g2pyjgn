    puts stderr {Name   : py-maturin}
    puts stderr {Version: 1.6.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Build and publish crates with pyo3, rust-cpython and cffi bindings as}
    puts stderr {well as rust binaries as python packages.}
}

