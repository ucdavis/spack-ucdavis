module-whatis {Corset is a command-line software program to go from a de novo transcriptome assembly to gene-level counts.}

proc ModulesHelp { } {
    puts stderr {Name   : corset}
    puts stderr {Version: 1.09}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Corset is a command-line software program to go from a de novo}
    puts stderr {transcriptome assembly to gene-level counts.}
}

conflict corset

prepend-path PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/environments/main/view/generic/corset-1.09/bin}
