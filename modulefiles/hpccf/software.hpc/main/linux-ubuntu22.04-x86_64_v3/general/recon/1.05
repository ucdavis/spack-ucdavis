    puts stderr {Version: 1.05}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {RECON: a package for automated de novo identification of repeat families}
    puts stderr {from genomic sequences.}
}

if {![info exists ::env(LMOD_VERSION_MAJOR)]} {
