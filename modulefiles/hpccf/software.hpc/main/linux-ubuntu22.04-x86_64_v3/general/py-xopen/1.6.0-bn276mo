module-whatis {This small Python module provides a xopen function that works like the built-in open function, but can also deal with compressed files. Supported compression formats are gzip, bzip2 and xz. They are automatically recognized by their file extensions .gz, .bz2 or .xz.}

proc ModulesHelp { } {
    puts stderr {Name   : py-xopen}
    puts stderr {Version: 1.6.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {This small Python module provides a xopen function that works like the}
    puts stderr {built-in open function, but can also deal with compressed files.}
    puts stderr {Supported compression formats are gzip, bzip2 and xz. They are}
    puts stderr {automatically recognized by their file extensions .gz, .bz2 or .xz.}
}

