    puts stderr {Name   : libxcb}
    puts stderr {Version: 1.17.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The X protocol C-language Binding (XCB) is a replacement for Xlib}
    puts stderr {featuring a small footprint, latency hiding, direct access to the}
    puts stderr {protocol, improved threading support, and extensibility.}
}

