module-whatis { The Ngram Statistics Package (NSP) is a suite of programs that aids in analyzing Ngrams in text files. }

proc ModulesHelp { } {
    puts stderr {Name   : perl-text-nsp}
    puts stderr {Version: 1.31}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr { The Ngram Statistics Package (NSP) is a suite of programs that aids in}
    puts stderr {analyzing Ngrams in text files.}
}

