## libxfont@1.5.4%gcc@13.2.0 build_system=autotools arch=linux-ubuntu22.04-x86_64_v3/cujgcuj
##


module-whatis {libXfont provides the core of the legacy X11 font system, handling the index files (fonts.dir, fonts.alias, fonts.scale), the various font file formats, and rasterizing them. It is used by the X servers, the X Font Server (xfs), and some font utilities (bdftopcf for instance), but should not be used by normal X11 clients. X11 clients access fonts via either the new API's in libXft, or the legacy API's in libX11.}

proc ModulesHelp { } {
    puts stderr {Name   : libxfont}
    puts stderr {Version: 1.5.4}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {libXfont provides the core of the legacy X11 font system, handling the}
    puts stderr {index files (fonts.dir, fonts.alias, fonts.scale), the various font file}
    puts stderr {formats, and rasterizing them. It is used by the X servers, the X Font}
    puts stderr {Server (xfs), and some font utilities (bdftopcf for instance), but}
    puts stderr {should not be used by normal X11 clients. X11 clients access fonts via}
    puts stderr {either the new API's in libXft, or the legacy API's in libX11.}
}

