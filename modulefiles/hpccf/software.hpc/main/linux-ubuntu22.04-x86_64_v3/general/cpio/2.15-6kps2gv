module-whatis {GNU cpio copies files into or out of a cpio or tar archive and the file system. The archive can be another file on the disk, a magnetic tape, or a pipe. }

proc ModulesHelp { } {
    puts stderr {Name   : cpio}
    puts stderr {Version: 2.15}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {GNU cpio copies files into or out of a cpio or tar archive and the file}
    puts stderr {system. The archive can be another file on the disk, a magnetic tape, or}
    puts stderr {a pipe.}
}

conflict cpio

prepend-path PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/cpio-2.15-6kps2gvth4ikimerwmgx7krzrfj5g6ae/bin}
