prepend-path CMAKE_PREFIX_PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/cpio-2.15-6kps2gvth4ikimerwmgx7krzrfj5g6ae/.}
setenv CPIO_ROOT {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/cpio-2.15-6kps2gvth4ikimerwmgx7krzrfj5g6ae}
