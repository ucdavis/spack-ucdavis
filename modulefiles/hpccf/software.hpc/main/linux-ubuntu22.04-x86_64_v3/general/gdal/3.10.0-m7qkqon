module-whatis {GDAL: Geospatial Data Abstraction Library.}

proc ModulesHelp { } {
    puts stderr {Name   : gdal}
    puts stderr {Version: 3.10.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {GDAL: Geospatial Data Abstraction Library. GDAL is a translator library}
    puts stderr {for raster and vector geospatial data formats that is released under an}
    puts stderr {MIT style Open Source License by the Open Source Geospatial Foundation.}
    puts stderr {As a library, it presents a single raster abstract data model and single}
    puts stderr {vector abstract data model to the calling application for all supported}
    puts stderr {formats. It also comes with a variety of useful command line utilities}
    puts stderr {for data translation and processing.}
}

