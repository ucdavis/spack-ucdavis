module-whatis {This module checks whether a particular dynamic library is available for FFI to use. It is modeled heavily on Devel::CheckLib, but will find dynamic libraries even when development packages are not installed. It also provides a find_lib function that will return the full path to the found dynamic library, which can be feed directly into FFI::Platypus or another FFI system.}

proc ModulesHelp { } {
    puts stderr {Name   : perl-ffi-checklib}
    puts stderr {Version: 0.31}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {This module checks whether a particular dynamic library is available for}
    puts stderr {FFI to use. It is modeled heavily on Devel::CheckLib, but will find}
    puts stderr {dynamic libraries even when development packages are not installed. It}
    puts stderr {also provides a find_lib function that will return the full path to the}
    puts stderr {found dynamic library, which can be feed directly into FFI::Platypus or}
    puts stderr {another FFI system.}
}

