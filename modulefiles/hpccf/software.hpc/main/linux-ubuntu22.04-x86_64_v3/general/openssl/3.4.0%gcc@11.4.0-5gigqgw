    puts stderr {Name   : openssl}
    puts stderr {Version: 3.4.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {OpenSSL is an open source project that provides a robust, commercial-}
    puts stderr {grade, and full-featured toolkit for the Transport Layer Security (TLS)}
    puts stderr {and Secure Sockets Layer (SSL) protocols. It is also a general-purpose}
    puts stderr {cryptography library.}
}

