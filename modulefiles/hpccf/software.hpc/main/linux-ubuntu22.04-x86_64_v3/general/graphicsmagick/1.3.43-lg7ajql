module-whatis {GraphicsMagick is the swiss army knife of image processing.}

proc ModulesHelp { } {
    puts stderr {Name   : graphicsmagick}
    puts stderr {Version: 1.3.43}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {GraphicsMagick is the swiss army knife of image processing. Provides a}
    puts stderr {robust and efficient collection of tools and libraries which support}
    puts stderr {reading, writing, and manipulating an image in over 88 major formats}
    puts stderr {including important formats like DPX, GIF, JPEG, JPEG-2000, PNG, PDF,}
    puts stderr {PNM, and TIFF.}
}

