module-whatis {Minimap2 is a versatile sequence alignment program that aligns DNA or mRNA sequences against a large reference database. Mappy provides a convenient interface to minimap2.}

proc ModulesHelp { } {
    puts stderr {Name   : minimap2}
    puts stderr {Version: 2.28}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Minimap2 is a versatile sequence alignment program that aligns DNA or}
    puts stderr {mRNA sequences against a large reference database. Mappy provides a}
    puts stderr {convenient interface to minimap2.}
}

