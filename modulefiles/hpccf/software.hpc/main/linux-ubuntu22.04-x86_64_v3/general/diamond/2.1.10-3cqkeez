    puts stderr {Name   : diamond}
    puts stderr {Version: 2.1.10}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {DIAMOND is a sequence aligner for protein and translated DNA searches,}
    puts stderr {designed for high performance analysis of big sequence data.}
}

