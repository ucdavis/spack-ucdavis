module-whatis {Bison is a general-purpose parser generator that converts an annotated context-free grammar into a deterministic LR or generalized LR (GLR) parser employing LALR(1) parser tables.}

proc ModulesHelp { } {
    puts stderr {Name   : bison}
    puts stderr {Version: 3.8.2}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Bison is a general-purpose parser generator that converts an annotated}
    puts stderr {context-free grammar into a deterministic LR or generalized LR (GLR)}
    puts stderr {parser employing LALR(1) parser tables.}
}

