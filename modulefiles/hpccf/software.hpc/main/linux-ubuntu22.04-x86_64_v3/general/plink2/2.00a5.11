    puts stderr {Version: 2.00a5.11}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {PLINK2: Whole genome association analysis toolset, designed to perform a}
    puts stderr {range of basic, large-scale analyses in a computationally efficient}
    puts stderr {manner.}
}

