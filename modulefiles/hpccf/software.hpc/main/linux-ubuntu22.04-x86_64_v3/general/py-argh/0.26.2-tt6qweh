module-whatis {An argparse wrapper that doesn't make you say 'argh' each time you deal with it.}

proc ModulesHelp { } {
    puts stderr {Name   : py-argh}
    puts stderr {Version: 0.26.2}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {An argparse wrapper that doesn't make you say "argh" each time you deal}
    puts stderr {with it. Building a command-line interface? Found yourself uttering}
    puts stderr {"argh!" while struggling with the API of argparse? Don't like the}
    puts stderr {complexity but need the power? Argh is a smart wrapper for argparse.}
    puts stderr {Argparse is a very powerful tool; Argh just makes it easy to use.}
}

