    puts stderr {Name   : spades}
    puts stderr {Version: 4.1.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {SPAdes - St. Petersburg genome assembler - is intended for both standard}
    puts stderr {isolates and single-cell MDA bacteria assemblies.}
}

