module-whatis {MySQL++ is a C++ wrapper for MySQL and MariaDB C APIs. It is built on the same principles as the Standard C++ Library to make dealing with the database as easy as dealing with std containers. MySQL++ also provides facilities that let you avoid the most repetitive sorts of SQL within your own code, providing native C++ interfaces for these common tasks.}

proc ModulesHelp { } {
    puts stderr {Name   : mysqlpp}
    puts stderr {Version: 3.3.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {MySQL++ is a C++ wrapper for MySQL and MariaDB C APIs. It is built on}
    puts stderr {the same principles as the Standard C++ Library to make dealing with the}
    puts stderr {database as easy as dealing with std containers. MySQL++ also provides}
    puts stderr {facilities that let you avoid the most repetitive sorts of SQL within}
    puts stderr {your own code, providing native C++ interfaces for these common tasks.}
}

