module-whatis {A platform-independent file lock for Python.}

proc ModulesHelp { } {
    puts stderr {Name   : py-filelock}
    puts stderr {Version: 3.12.4}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {A platform-independent file lock for Python. This package contains a}
    puts stderr {single module, which implements a platform independent file lock in}
    puts stderr {Python, which provides a simple way of inter-process communication}
}

