module-whatis {The intention of rich-click is to provide attractive help output from click, formatted with rich, with minimal customisation required.}

proc ModulesHelp { } {
    puts stderr {Name   : py-rich-click}
    puts stderr {Version: 1.5.2}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The intention of rich-click is to provide attractive help output from}
    puts stderr {click, formatted with rich, with minimal customisation required.}
}

