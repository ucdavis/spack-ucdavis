module-whatis {An AST unparser for Python.}

proc ModulesHelp { } {
    puts stderr {Name   : py-astunparse}
    puts stderr {Version: 1.6.3}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {An AST unparser for Python. This is a factored out version of unparse}
    puts stderr {found in the Python source distribution; under Demo/parser in Python 2}
    puts stderr {and under Tools/parser in Python 3.}
}

