    puts stderr {Name   : perl-dbi}
    puts stderr {Version: 1.645}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The DBI is the standard database interface module for Perl. It defines a}
    puts stderr {set of methods, variables and conventions that provide a consistent}
    puts stderr {database interface independent of the actual database being used.}
}

