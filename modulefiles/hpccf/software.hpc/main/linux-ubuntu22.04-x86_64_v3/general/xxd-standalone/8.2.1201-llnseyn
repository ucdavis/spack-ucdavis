module-whatis {xxd creates a hex dump of a given file or standard input. It is bundled with vim, but as xxd is used in build scripts, it makes sense to have it available as a standalone package.}

proc ModulesHelp { } {
    puts stderr {Name   : xxd-standalone}
    puts stderr {Version: 8.2.1201}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {xxd creates a hex dump of a given file or standard input. It is bundled}
    puts stderr {with vim, but as xxd is used in build scripts, it makes sense to have it}
    puts stderr {available as a standalone package.}
}

conflict xxd-standalone

prepend-path PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/xxd-standalone-8.2.1201-llnseynzibjkc6lnkf7x2n3ckcmfx632/bin}
prepend-path CMAKE_PREFIX_PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/xxd-standalone-8.2.1201-llnseynzibjkc6lnkf7x2n3ckcmfx632/.}
setenv XXD_STANDALONE_ROOT {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/xxd-standalone-8.2.1201-llnseynzibjkc6lnkf7x2n3ckcmfx632}

