    puts stderr {Name   : xcb-proto}
    puts stderr {Version: 1.17.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {xcb-proto provides the XML-XCB protocol descriptions that libxcb uses to}
    puts stderr {generate the majority of its code and API.}
}

