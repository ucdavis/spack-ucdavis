    puts stderr {languages such as C, Objective-C, C#, PHP, Java, Python, IDL (Corba,}
    puts stderr {Microsoft, and UNO/OpenOffice flavors), Fortran, VHDL, Tcl, and to some}
    puts stderr {extent D..}
}

