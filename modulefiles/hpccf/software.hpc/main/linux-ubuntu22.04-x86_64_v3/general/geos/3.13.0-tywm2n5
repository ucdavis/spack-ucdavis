module-whatis {GEOS (Geometry Engine, Open Source).}

proc ModulesHelp { } {
    puts stderr {Name   : geos}
    puts stderr {Version: 3.13.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {GEOS (Geometry Engine, Open Source). GEOS is a C/C++ library for}
    puts stderr {computational geometry with a focus on algorithms used in geographic}
    puts stderr {information systems (GIS) software. It implements the OGC Simple}
    puts stderr {Features geometry model and provides all the spatial functions in that}
    puts stderr {standard as well as many others. GEOS is a core dependency of PostGIS,}
    puts stderr {QGIS, GDAL, and Shapely.}
}

