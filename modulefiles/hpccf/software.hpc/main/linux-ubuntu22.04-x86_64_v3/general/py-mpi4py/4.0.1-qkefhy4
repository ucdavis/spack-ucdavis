module-whatis {This package provides Python bindings for the Message Passing Interface (MPI) standard. It is implemented on top of the MPI-1/MPI-2 specification and exposes an API which grounds on the standard MPI-2 C++ bindings. }

proc ModulesHelp { } {
    puts stderr {Name   : py-mpi4py}
    puts stderr {Version: 4.0.1}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {This package provides Python bindings for the Message Passing Interface}
    puts stderr {(MPI) standard. It is implemented on top of the MPI-1/MPI-2}
    puts stderr {specification and exposes an API which grounds on the standard MPI-2 C++}
    puts stderr {bindings.}
}

