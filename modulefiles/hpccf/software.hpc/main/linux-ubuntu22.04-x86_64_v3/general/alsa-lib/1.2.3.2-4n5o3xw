module-whatis {The Advanced Linux Sound Architecture (ALSA) provides audio and MIDI functionality to the Linux operating system. alsa-lib contains the user space library that developers compile ALSA applications against.}

proc ModulesHelp { } {
    puts stderr {Name   : alsa-lib}
    puts stderr {Version: 1.2.3.2}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The Advanced Linux Sound Architecture (ALSA) provides audio and MIDI}
    puts stderr {functionality to the Linux operating system. alsa-lib contains the user}
    puts stderr {space library that developers compile ALSA applications against.}
}

