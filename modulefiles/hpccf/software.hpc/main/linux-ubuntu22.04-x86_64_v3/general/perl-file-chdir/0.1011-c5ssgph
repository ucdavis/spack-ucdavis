module-whatis {Perl's chdir() has the unfortunate problem of being very, very, very global. If any part of your program calls chdir() or if any library you use calls chdir(), it changes the current working directory for the *whole* program.}

proc ModulesHelp { } {
    puts stderr {Name   : perl-file-chdir}
    puts stderr {Version: 0.1011}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Perl's chdir() has the unfortunate problem of being very, very, very}
    puts stderr {global. If any part of your program calls chdir() or if any library you}
    puts stderr {use calls chdir(), it changes the current working directory for the}
    puts stderr {*whole* program. This sucks. File::chdir gives you an alternative, $CWD}
    puts stderr {and @CWD. These two variables combine all the power of chdir(),}
    puts stderr {File::Spec and Cwd.}
}

if {![info exists ::env(LMOD_VERSION_MAJOR)]} {
