module-whatis {FLTK (pronounced 'fulltick') is a cross-platform C++ GUI toolkit for UNIX/Linux (X11), Microsoft Windows, and MacOS X. FLTK provides modern GUI functionality without the bloat and supports 3D graphics via OpenGL and its built-in GLUT emulation.}

proc ModulesHelp { } {
    puts stderr {Name   : fltk}
    puts stderr {Version: 1.3.7}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {FLTK (pronounced "fulltick") is a cross-platform C++ GUI toolkit for}
    puts stderr {UNIX/Linux (X11), Microsoft Windows, and MacOS X. FLTK provides modern}
    puts stderr {GUI functionality without the bloat and supports 3D graphics via OpenGL}
    puts stderr {and its built-in GLUT emulation. FLTK is designed to be small and}
    puts stderr {modular enough to be statically linked, but works fine as a shared}
    puts stderr {library. FLTK also includes an excellent UI builder called FLUID that}
    puts stderr {can be used to create applications in minutes.}
}

