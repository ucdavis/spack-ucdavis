module-whatis {This library contains the public client interface for NIS(YP) and NIS+ in a IPv6 ready version.}

proc ModulesHelp { } {
    puts stderr {Name   : libnsl}
    puts stderr {Version: 2.0.1}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {This library contains the public client interface for NIS(YP) and NIS+}
    puts stderr {in a IPv6 ready version.}
}

