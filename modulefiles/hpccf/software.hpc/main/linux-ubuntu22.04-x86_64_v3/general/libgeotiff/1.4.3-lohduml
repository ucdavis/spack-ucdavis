module-whatis {GeoTIFF represents an effort by over 160 different remote sensing, GIS, cartographic, and surveying related companies and organizations to establish a TIFF based interchange format for georeferenced raster imagery. }

proc ModulesHelp { } {
    puts stderr {Name   : libgeotiff}
    puts stderr {Version: 1.4.3}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {GeoTIFF represents an effort by over 160 different remote sensing, GIS,}
    puts stderr {cartographic, and surveying related companies and organizations to}
    puts stderr {establish a TIFF based interchange format for georeferenced raster}
    puts stderr {imagery.}
}

