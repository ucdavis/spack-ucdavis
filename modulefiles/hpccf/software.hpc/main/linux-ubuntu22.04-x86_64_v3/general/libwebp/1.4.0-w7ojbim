module-whatis {WebP is a modern image format that provides superior lossless and lossy compression for images on the web. Using WebP, webmasters and web developers can create smaller, richer images that make the web faster.}

proc ModulesHelp { } {
    puts stderr {Name   : libwebp}
    puts stderr {Version: 1.4.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {WebP is a modern image format that provides superior lossless and lossy}
    puts stderr {compression for images on the web. Using WebP, webmasters and web}
    puts stderr {developers can create smaller, richer images that make the web faster.}
}

