module-whatis {Parses image file headers and returns image size. Supports PNG, JPEG, JPEG2000, and GIF image file formats.}

proc ModulesHelp { } {
    puts stderr {Name   : py-imagesize}
    puts stderr {Version: 1.4.1}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Parses image file headers and returns image size. Supports PNG, JPEG,}
    puts stderr {JPEG2000, and GIF image file formats.}
}

