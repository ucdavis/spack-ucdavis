module-whatis {libvpx is a free software video codec library from Google and the Alliance for Open Media. It serves as the reference software implementation for the VP8 and VP9 video coding formats, and for AV1 a special fork named libaom that was stripped of backwards compatibility. }

proc ModulesHelp { } {
    puts stderr {Name   : libvpx}
    puts stderr {Version: 1.14.1}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {libvpx is a free software video codec library from Google and the}
    puts stderr {Alliance for Open Media. It serves as the reference software}
    puts stderr {implementation for the VP8 and VP9 video coding formats, and for AV1 a}
    puts stderr {special fork named libaom that was stripped of backwards compatibility.}
}

