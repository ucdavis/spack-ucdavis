    puts stderr {Name   : atk}
    puts stderr {Version: 2.38.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {ATK provides the set of accessibility interfaces that are implemented by}
    puts stderr {other toolkits and applications. Using the ATK interfaces, accessibility}
    puts stderr {tools have full access to view and control running applications.}
}

