prepend-path PKG_CONFIG_PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/amdscalapack-5.0-6zp6qzxevsymoxhehfk4s72cioc3lw64/lib/pkgconfig}
