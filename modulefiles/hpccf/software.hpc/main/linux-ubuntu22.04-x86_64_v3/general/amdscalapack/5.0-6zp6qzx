module-whatis { ScaLAPACK is a library of high-performance linear algebra routines for parallel distributed memory machines. It depends on external libraries including BLAS and LAPACK for Linear Algebra computations.}

proc ModulesHelp { } {
    puts stderr {Name   : amdscalapack}
    puts stderr {Version: 5.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr { ScaLAPACK is a library of high-performance linear algebra routines for}
    puts stderr {parallel distributed memory machines. It depends on external libraries}
    puts stderr {including BLAS and LAPACK for Linear Algebra computations. AMD's}
    puts stderr {optimized version of ScaLAPACK enables using BLIS and LibFLAME library}
    puts stderr {that have optimized dense matrix functions and solvers for AMD EPYC}
    puts stderr {processor family CPUs. LICENSING INFORMATION: By downloading, installing}
    puts stderr {and using this software, you agree to the terms and conditions of the}
    puts stderr {AMD AOCL-ScaLAPACK license agreement. You may obtain a copy of this}
    puts stderr {license agreement from}
    puts stderr {https://www.amd.com/en/developer/aocl/scalapack/eula/scalapack-}
    puts stderr {libraries-4-2-eula.html}
    puts stderr {https://www.amd.com/en/developer/aocl/scalapack/eula/scalapack-}
    puts stderr {libraries-eula.html}
}

conflict amdscalapack

