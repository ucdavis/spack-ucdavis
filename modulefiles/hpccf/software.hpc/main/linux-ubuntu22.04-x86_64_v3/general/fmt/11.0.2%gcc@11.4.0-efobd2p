    puts stderr {Name   : fmt}
    puts stderr {Version: 11.0.2}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {fmt (formerly cppformat) is an open-source formatting library. It can be}
    puts stderr {used as a safe alternative to printf or as a fast alternative to C++}
    puts stderr {IOStreams.}
}

