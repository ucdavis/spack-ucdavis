module-whatis {CDO is a collection of command line Operators to manipulate and analyse Climate and NWP model Data. }

proc ModulesHelp { } {
    puts stderr {Name   : cdo}
    puts stderr {Version: 2.4.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {CDO is a collection of command line Operators to manipulate and analyse}
    puts stderr {Climate and NWP model Data.}
}

conflict cdo

prepend-path PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/environments/main/view/generic/cdo-2.4.0/bin}
prepend-path CMAKE_PREFIX_PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/environments/main/view/generic/cdo-2.4.0/.}
setenv CDO_ROOT {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/cdo-2.4.0-hfj42rvwxl5atajjucyr6hrdlms7kzgz}

