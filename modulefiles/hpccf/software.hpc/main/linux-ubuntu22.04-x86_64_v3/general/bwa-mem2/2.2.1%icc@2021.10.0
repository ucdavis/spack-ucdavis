module-whatis {The tool bwa-mem2 is the next version of the bwa-mem algorithm in bwa. It produces alignment identical to bwa and is ~1.3-3.1x faster depending on the use-case, dataset and the running machine.}

proc ModulesHelp { } {
    puts stderr {Name   : bwa-mem2}
    puts stderr {Version: 2.2.1}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The tool bwa-mem2 is the next version of the bwa-mem algorithm in bwa.}
    puts stderr {It produces alignment identical to bwa and is ~1.3-3.1x faster depending}
    puts stderr {on the use-case, dataset and the running machine.}
}

conflict bwa-mem2

prepend-path PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/environments/main/view/generic/bwa-mem2-2.2.1/bin}
prepend-path CMAKE_PREFIX_PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/environments/main/view/generic/bwa-mem2-2.2.1/.}
setenv BWA_MEM2_ROOT {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/intel-2021.10.0/bwa-mem2-2.2.1-qnfbqkptouhpzaxdcsnppynjp6ekhhc6}

