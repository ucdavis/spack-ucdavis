    puts stderr {Name   : py-versioneer}
    puts stderr {Version: 0.29}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Versioneer is a tool to automatically update version strings by asking}
    puts stderr {your version-control system about the current tree.}
}

