module-whatis {The ViennaRNA Package consists of a C code library and several stand-alone programs for the prediction and comparison of RNA secondary structures. }

proc ModulesHelp { } {
    puts stderr {Name   : viennarna}
    puts stderr {Version: 2.6.4}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The ViennaRNA Package consists of a C code library and several stand-}
    puts stderr {alone programs for the prediction and comparison of RNA secondary}
    puts stderr {structures.}
}

