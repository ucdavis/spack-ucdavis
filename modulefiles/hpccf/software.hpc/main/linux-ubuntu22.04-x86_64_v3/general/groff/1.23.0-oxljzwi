module-whatis {Groff (GNU troff) is a typesetting system that reads plain text mixed with formatting commands and produces formatted output. Output may be PostScript or PDF, html, or ASCII/UTF8 for display at the terminal.}

proc ModulesHelp { } {
    puts stderr {Name   : groff}
    puts stderr {Version: 1.23.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Groff (GNU troff) is a typesetting system that reads plain text mixed}
    puts stderr {with formatting commands and produces formatted output. Output may be}
    puts stderr {PostScript or PDF, html, or ASCII/UTF8 for display at the terminal.}
}

