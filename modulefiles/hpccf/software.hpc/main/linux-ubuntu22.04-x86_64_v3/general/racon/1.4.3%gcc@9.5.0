module-whatis {Ultrafast consensus module for raw de novo genome assembly of long uncorrected reads.}

proc ModulesHelp { } {
    puts stderr {Name   : racon}
    puts stderr {Version: 1.4.3}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Ultrafast consensus module for raw de novo genome assembly of long}
    puts stderr {uncorrected reads.}
}

conflict racon

prepend-path PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/environments/main/view/generic/racon-1.4.3/bin}
prepend-path CMAKE_PREFIX_PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/environments/main/view/generic/racon-1.4.3/.}
setenv RACON_ROOT {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-9.5.0/racon-1.4.3-ksrguzh363begasfogjoro75lvnjridk}

