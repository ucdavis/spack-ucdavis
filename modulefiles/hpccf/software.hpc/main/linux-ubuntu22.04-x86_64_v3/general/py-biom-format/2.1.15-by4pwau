    puts stderr {Name   : py-biom-format}
    puts stderr {Version: 2.1.15}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The BIOM file format (canonically pronounced biome) is designed to be a}
    puts stderr {general-use format for representing biological sample by observation}
    puts stderr {contingency tables.}
}

