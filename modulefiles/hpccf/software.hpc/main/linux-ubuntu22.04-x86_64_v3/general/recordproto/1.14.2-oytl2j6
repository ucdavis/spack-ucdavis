module-whatis {X Record Extension.}

proc ModulesHelp { } {
    puts stderr {Name   : recordproto}
    puts stderr {Version: 1.14.2}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {X Record Extension. This extension defines a protocol for the recording}
    puts stderr {and playback of user actions in the X Window System.}
}

