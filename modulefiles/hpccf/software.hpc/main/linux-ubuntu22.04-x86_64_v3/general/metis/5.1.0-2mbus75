module-whatis {METIS is a set of serial programs for partitioning graphs, partitioning finite element meshes, and producing fill reducing orderings for sparse matrices.}

proc ModulesHelp { } {
    puts stderr {Name   : metis}
    puts stderr {Version: 5.1.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {METIS is a set of serial programs for partitioning graphs, partitioning}
    puts stderr {finite element meshes, and producing fill reducing orderings for sparse}
    puts stderr {matrices. The algorithms implemented in METIS are based on the}
    puts stderr {multilevel recursive-bisection, multilevel k-way, and multi-constraint}
    puts stderr {partitioning schemes.}
}

conflict metis

