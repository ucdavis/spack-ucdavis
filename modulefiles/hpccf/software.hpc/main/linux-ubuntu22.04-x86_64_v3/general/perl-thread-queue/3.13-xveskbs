module-whatis {Thread::Queue - Thread-safe queues.}

proc ModulesHelp { } {
    puts stderr {Name   : perl-thread-queue}
    puts stderr {Version: 3.13}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Thread::Queue - Thread-safe queues. This module provides thread-safe}
    puts stderr {FIFO queues that can be accessed safely by any number of threads.}
}

