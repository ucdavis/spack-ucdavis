module-whatis {Xerces-C++ is a validating XML parser written in a portable subset of C++. Xerces-C++ makes it easy to give your application the ability to read and write XML data. A shared library is provided for parsing, generating, manipulating, and validating XML documents using the DOM, SAX, and SAX2 APIs.}

proc ModulesHelp { } {
    puts stderr {Name   : xerces-c}
    puts stderr {Version: 3.3.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Xerces-C++ is a validating XML parser written in a portable subset of}
    puts stderr {C++. Xerces-C++ makes it easy to give your application the ability to}
    puts stderr {read and write XML data. A shared library is provided for parsing,}
    puts stderr {generating, manipulating, and validating XML documents using the DOM,}
    puts stderr {SAX, and SAX2 APIs.}
}

