module-whatis {libelf lets you read, modify or create ELF object files in an architecture-independent way. The library takes care of size and endian issues, e.g. you can process a file for SPARC processors on an Intel-based system. Note: libelf is no longer maintained and packages that depend on libelf should migrate to elfutils.}

proc ModulesHelp { } {
    puts stderr {Name   : libelf}
    puts stderr {Version: 0.8.13}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {libelf lets you read, modify or create ELF object files in an}
    puts stderr {architecture-independent way. The library takes care of size and endian}
    puts stderr {issues, e.g. you can process a file for SPARC processors on an Intel-}
    puts stderr {based system. Note: libelf is no longer maintained and packages that}
    puts stderr {depend on libelf should migrate to elfutils.}
}

