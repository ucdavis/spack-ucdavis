module-whatis {Implements inside-out objects as anonymous scalar references that are blessed into a class with the scalar containing the ID for the object (usually a sequence number).}

proc ModulesHelp { } {
    puts stderr {Name   : perl-object-insideout}
    puts stderr {Version: 4.05}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Implements inside-out objects as anonymous scalar references that are}
    puts stderr {blessed into a class with the scalar containing the ID for the object}
    puts stderr {(usually a sequence number).}
}

