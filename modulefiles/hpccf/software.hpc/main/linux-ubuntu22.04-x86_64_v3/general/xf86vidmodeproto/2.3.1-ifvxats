module-whatis {XFree86 Video Mode Extension.}

proc ModulesHelp { } {
    puts stderr {Name   : xf86vidmodeproto}
    puts stderr {Version: 2.3.1}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {XFree86 Video Mode Extension. This extension defines a protocol for}
    puts stderr {dynamically configuring modelines and gamma.}
}

