module-whatis {Seaborn: statistical data visualization.}

proc ModulesHelp { } {
    puts stderr {Name   : py-seaborn}
    puts stderr {Version: 0.13.2}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Seaborn: statistical data visualization. Seaborn is a library for making}
    puts stderr {attractive and informative statistical graphics in Python. It is built}
    puts stderr {on top of matplotlib and tightly integrated with the PyData stack,}
    puts stderr {including support for numpy and pandas data structures and statistical}
    puts stderr {routines from scipy and statsmodels.}
}

