module-whatis {This module provides tools for building external (non-CPAN) dependencies for CPAN. It is mainly designed to be used at install time of a CPAN client, and work closely with Alien::Base which is used at runtime.}

proc ModulesHelp { } {
    puts stderr {Name   : perl-alien-build}
    puts stderr {Version: 2.78}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {This module provides tools for building external (non-CPAN) dependencies}
    puts stderr {for CPAN. It is mainly designed to be used at install time of a CPAN}
    puts stderr {client, and work closely with Alien::Base which is used at runtime.}
}

