prepend-path LIBRARY_PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/perl-perl-unsafe-signals-0.03-tmrcr6hdyleqm3ivbb6kftlpceaz2orn/lib}
prepend-path CMAKE_PREFIX_PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/perl-perl-unsafe-signals-0.03-tmrcr6hdyleqm3ivbb6kftlpceaz2orn/.}
prepend-path PERL5LIB {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/perl-perl-unsafe-signals-0.03-tmrcr6hdyleqm3ivbb6kftlpceaz2orn/lib/perl5}
