module-whatis {This project (double-conversion) provides binary-decimal and decimal-binary routines for IEEE doubles.}

proc ModulesHelp { } {
    puts stderr {Name   : double-conversion}
    puts stderr {Version: 3.3.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {This project (double-conversion) provides binary-decimal and decimal-}
    puts stderr {binary routines for IEEE doubles. The library consists of efficient}
    puts stderr {conversion routines that have been extracted from the V8 JavaScript}
    puts stderr {engine. The code has been refactored and improved so that it can be used}
    puts stderr {more easily in other projects. There is extensive documentation in}
    puts stderr {src/double-conversion.h. Other examples can be found in}
    puts stderr {test/cctest/test-conversions.cc.}
}

