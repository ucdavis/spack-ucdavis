prepend-path CPLUS_INCLUDE_PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/arpack-ng-3.9.0-evcmqvhst2m3bi3kvphiscwl5idpb7w6/include}
prepend-path PKG_CONFIG_PATH {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/arpack-ng-3.9.0-evcmqvhst2m3bi3kvphiscwl5idpb7w6/lib/pkgconfig}
