module-whatis {This module exports a number of wrappers around perl's builtin grok_number function, which returns the numeric type of its argument, or 0 if it isn't numeric.}

proc ModulesHelp { } {
    puts stderr {Name   : perl-scalar-util-numeric}
    puts stderr {Version: 0.40}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {This module exports a number of wrappers around perl's builtin}
    puts stderr {grok_number function, which returns the numeric type of its argument, or}
    puts stderr {0 if it isn't numeric.}
}

if {![info exists ::env(LMOD_VERSION_MAJOR)]} {
