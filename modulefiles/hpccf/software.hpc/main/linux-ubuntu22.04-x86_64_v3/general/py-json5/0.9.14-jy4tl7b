module-whatis {The JSON5 Data Interchange Format (JSON5) is a superset of JSON that aims to alleviate some of the limitations of JSON by expanding its syntax to include some productions from ECMAScript 5.1.}

proc ModulesHelp { } {
    puts stderr {Name   : py-json5}
    puts stderr {Version: 0.9.14}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The JSON5 Data Interchange Format (JSON5) is a superset of JSON that}
    puts stderr {aims to alleviate some of the limitations of JSON by expanding its}
    puts stderr {syntax to include some productions from ECMAScript 5.1.}
}

