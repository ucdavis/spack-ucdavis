    puts stderr {Name   : kokkos-nvcc-wrapper}
    puts stderr {Version: 4.4.01}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The NVCC wrapper provides a wrapper around NVCC to make it a 'full' C++}
    puts stderr {compiler that accepts all flags}
}

