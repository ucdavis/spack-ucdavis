    puts stderr {Name   : libmng}
    puts stderr {Version: 2.0.3}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {THE reference library for reading, displaying, writing and examining}
    puts stderr {Multiple-Image Network Graphics. MNG is the animation extension to the}
    puts stderr {popular PNG image format.}
}

