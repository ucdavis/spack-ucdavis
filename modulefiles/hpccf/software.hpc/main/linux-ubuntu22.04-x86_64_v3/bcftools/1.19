setenv BCFTOOLS_ROOT {/cvmfs/hpc.ucdavis.edu/sw/spack/main/linux-ubuntu22.04-x86_64_v3/gcc-13.2.0/bcftools-1.19-muqs2pa3j5meb2e4f4cwik7la7ftw4ez}
