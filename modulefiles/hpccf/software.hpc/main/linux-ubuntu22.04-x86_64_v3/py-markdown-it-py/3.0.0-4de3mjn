    puts stderr {Name   : py-markdown-it-py}
    puts stderr {Version: 3.0.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Markdown parser, done right. 100% CommonMark support, extensions, syntax}
    puts stderr {plugins & high speed}
}

