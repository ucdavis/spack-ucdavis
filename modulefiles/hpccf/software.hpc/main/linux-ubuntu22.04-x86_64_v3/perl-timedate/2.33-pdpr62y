    puts stderr {Name   : perl-timedate}
    puts stderr {Version: 2.33}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {The parser contained here will only parse absolute dates, if you want a}
    puts stderr {date parser that can parse relative dates then take a look at the Time}
    puts stderr {modules by David Muir on CPAN.}
}

