module-whatis {GnuTLS is a secure communications library implementing the SSL, TLS and DTLS protocols and technologies around them. It provides a simple C language application programming interface (API) to access the secure communications protocols as well as APIs to parse and write X.509, PKCS #12, OpenPGP and other required structures. It is aimed to be portable and efficient with focus on security and interoperability.}

proc ModulesHelp { } {
    puts stderr {Name   : gnutls}
    puts stderr {Version: 3.8.3}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {GnuTLS is a secure communications library implementing the SSL, TLS and}
    puts stderr {DTLS protocols and technologies around them. It provides a simple C}
    puts stderr {language application programming interface (API) to access the secure}
    puts stderr {communications protocols as well as APIs to parse and write X.509, PKCS}
    puts stderr {#12, OpenPGP and other required structures. It is aimed to be portable}
    puts stderr {and efficient with focus on security and interoperability.}
}

