    puts stderr {Name   : py-threadpoolctl}
    puts stderr {Version: 3.1.0}
    puts stderr {Target : x86_64_v3}
    puts stderr {}
    puts stderr {Python helpers to limit the number of threads used in the threadpool-}
    puts stderr {backed of common native libraries used for scientific computing and data}
    puts stderr {science (e.g. BLAS and OpenMP).}
}

