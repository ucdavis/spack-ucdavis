#%Module1.0

module-whatis "Dev module tree."


module unuse --prepend-on-unload \
  /cvmfs/hpc.ucdavis.edu/sw/spack/modulefiles/main/linux-ubuntu22.04-x86_64_v3/core \
  /cvmfs/hpc.ucdavis.edu/sw/spack/modulefiles/main/linux-ubuntu22.04-x86_64_v3/lang \
  /cvmfs/hpc.ucdavis.edu/sw/spack/modulefiles/main/linux-ubuntu22.04-x86_64_v3/general

if [module-info mode load] {

  module use  \
    /cvmfs/hpc.ucdavis.edu/sw/spack/modulefiles/main/linux-ubuntu22.04-zen2/core \
    /cvmfs/hpc.ucdavis.edu/sw/spack/modulefiles/main/linux-ubuntu22.04-x86_64_v3/core \
    /cvmfs/hpc.ucdavis.edu/sw/spack/modulefiles/main/linux-ubuntu22.04-zen2/lang \
    /cvmfs/hpc.ucdavis.edu/sw/spack/modulefiles/main/linux-ubuntu22.04-zen2/general


  module load slurm openmpi

  puts stderr "
This module loads a zen2-specific module tree. These modules can ONLY be executed on
nodes tagged with the zen2, zen3, or zen4 feature.
"
}

if [module-info mode unload] {
  module unuse \
    /cvmfs/hpc.ucdavis.edu/sw/spack/modulefiles/main/linux-ubuntu22.04-zen2/core \
    /cvmfs/hpc.ucdavis.edu/sw/spack/modulefiles/main/linux-ubuntu22.04-zen2/lang \
    /cvmfs/hpc.ucdavis.edu/sw/spack/modulefiles/main/linux-ubuntu22.04-zen2/general
}

